{
  "name": "suitcase-is-full",
  "version": "0.1.0",
  "private": true,
  "description": "《行李箱装不下啦！》微信休闲小游戏 —— 数据驱动、游戏逻辑与渲染层分离",
  "type": "module",
  "engineVersion": "3.8.8",
  "engineLockedAt": "2026-10-13",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:arch": "tsx tools/check-arch.ts",
    "check:art": "tsx tools/check-art.ts",
    "check:art:strict": "tsx tools/check-art.ts --strict",
    "art:missing": "tsx tools/check-art.ts --list-missing",
    "verify:levels": "tsx tools/verify-levels.ts",
    "report:difficulty": "tsx tools/difficulty-report.ts",
    "check": "npm run typecheck && npm run check:arch && npm run verify:levels && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
